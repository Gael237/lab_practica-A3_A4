# Copia este archivo como .env (nunca lo subas al repositorio: está en .gitignore)
# Proveedor del modelo: gemini | groq | ollama | fake
LLM_PROVIDER=gemini
# LLM_MODEL=gemini-flash-lite-latest
GEMINI_API_KEY=
# GROQ_API_KEY=
# OLLAMA_URL=http://localhost:11434

# Embeddings: gemini | ollama | local | hash (hash = sin red, solo para pruebas)
EMB_PROVIDER=gemini

# ── Laboratorio A3+A4 · producto ──
# Modelo recomendado para la capa gratuita (más cuota por minuto y por día):
# LLM_MODEL=gemini-flash-lite-latest
# Secreto para firmar tokens (mínimo 32 caracteres). Genéralo con:
#   python -c "import secrets; print(secrets.token_hex(32))"
TOKEN_SECRET=
# Dónde escucha el servicio (lo usa la interfaz app/cliente_api.py)
API_URL=http://127.0.0.1:8000
